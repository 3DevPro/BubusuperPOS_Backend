# Template for backend/.env.prod — copy to backend/.env.prod on the VPS and
# fill in real values. Never commit the filled-in file (it's gitignored).

# Left as the default here; infra/docker-compose.prod.yml overrides this to
# point at the postgres service on the compose network, so you normally
# don't need to set it yourself.
DATABASE_URL=postgresql+asyncpg://loyverse:loyverse@postgres:5432/loyverse

# REQUIRED: generate a real random secret, do not reuse the dev default.
# e.g. `openssl rand -hex 32`
# Leaving this blank does not fall back to anything safe — the backend
# refuses to start, and infra/deploy.sh refuses to deploy.
JWT_SECRET=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Not needed when Flutter web and the API are served from the same domain
# through Caddy (see infra/Caddyfile) — same-origin requests aren't
# preflighted. Only set this if a mobile app build calls the API directly
# cross-origin.
# CORS_ALLOW_ORIGIN_REGEX=https://your-domain\.com

# Optional — LINE OA push notifications (low-stock alerts, daily summary).
# Leave blank to run with in-app notifications only. Get these from the
# LINE Developers Console after creating a Messaging API channel: the
# channel secret and a long-lived channel access token (both under the
# channel's Messaging API tab), plus the OA's "@xxxxxxx" Basic ID. Set the
# channel's webhook URL to https://your-domain/api/v1/notifications/line/webhook
# and disable auto-reply/greeting messages so they don't interfere with the
# account-linking code flow.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OA_BASIC_ID=
